<Project Sdk="Microsoft.NET.Sdk">

  <!--
    seamcheck: resolves every patch target the CWY plugins register against a game's installed
    Managed/ folder, without running the game. Run it through ../seamcheck.sh.

    Game assemblies are only ever read through System.Reflection.MetadataLoadContext (metadata,
    no code runs). The CWY plugin assemblies are loaded normally: the tool finds every
    PatchTargetRegistry.Register call site in their IL and reads the static table each one passes.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>seamcheck</AssemblyName>
    <RootNamespace>CWY.Seamcheck</RootNamespace>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

  <!--
    Every plugin project under src/, by wildcard, so a plugin assembly added later is scanned for
    registrations without anyone editing this file. Copied next to the tool (Private defaults to
    true here); their game and BepInEx references stay Private=false and are never copied.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../src/*/*.csproj" Exclude="../../../src/*.Tests/*.csproj" />
  </ItemGroup>

  <!--
    BepInEx's logging types, from the repo payload (never the game): a table getter that logs on a
    failure path (Voice/VoiceSeam) references ManualLogSource, and the runtime must be able to
    compile it to read the table offline.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)/BepInEx.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    The Trace plugin's Unity-free rules, compiled in rather than loaded, so the preflight runs the
    same exclusion table and the same method-candidate code the in-game trace does.
  -->
  <ItemGroup>
    <Compile Include="../../../src/CwyLs.ModLoader.Trace/TraceExclusions.cs" Link="Shared/TraceExclusions.cs" />
    <Compile Include="../../../src/CwyLs.ModLoader.Trace/TraceCandidates.cs" Link="Shared/TraceCandidates.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seamcheck.Tests" />
  </ItemGroup>

</Project>
