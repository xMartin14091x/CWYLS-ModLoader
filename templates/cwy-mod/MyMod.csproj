<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A CWY:LS Mod Loader code mod. Copy this folder, rename it and this file, set ModId below and the
    id/entryDll in manifest.json, then: dotnet build -c Release
    The build output bin/Release/netstandard2.1/pack/<ModId>/ holds exactly what goes into
    <game root>/CWYLS Mods/<ModId>/: your DLL, its symbols, the manifest, and your private
    dependencies (NuGet packages or DLLs you reference with Private=true) that the game does not
    already provide.

    References come from a CWY:LS Mod Loader checkout whose framework is built (CwyRepoRoot) and from
    the installed game: its Managed folder (GameManagedPath) and the BepInEx installed in it
    (BepInExCorePath, <game root>/BepInEx/core). Inside the checkout all of them are found
    automatically; from anywhere else pass the checkout, and the game folder when it is not in the
    default Steam library:
      dotnet build -c Release -p:CwyRepoRoot=/path/to/checkout/ -p:SteamGameRoot=/path/to/game/
  -->

  <PropertyGroup>
    <ModId>yourname.mymod</ModId>
    <AssemblyName>MyMod</AssemblyName>
    <RootNamespace>MyMod</RootNamespace>
    <Version>0.1.0</Version>

    <!-- The game runs Unity 2022.3 on Mono: netstandard2.1 is what it loads. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- NuGet packages' DLLs flow into the build output, so the pack step below can ship them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <CwyRepoRoot Condition="'$(CwyRepoRoot)' == ''">$(MSBuildThisFileDirectory)../../</CwyRepoRoot>
    <CwyConfiguration Condition="'$(CwyConfiguration)' == ''">Release</CwyConfiguration>
  </PropertyGroup>

  <!--
    The installed game, with BepInEx installed in it: the default Steam library unless
    SteamGameRoot is given. Each property can also be set on its own (-p:GameManagedPath=...,
    -p:BepInExCorePath=...). Inside the checkout, its Directory.Build.props sets them first.
  -->
  <PropertyGroup>
    <SteamGameRoot Condition="'$(SteamGameRoot)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Chill with You Lo-Fi Story</SteamGameRoot>
    <SteamGameRoot Condition="'$(SteamGameRoot)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Chill with You Lo-Fi Story</SteamGameRoot>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and '$(OS)' == 'Windows_NT'">$(SteamGameRoot)\Chill With You_Data\Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(SteamGameRoot)/Chill With You.app/Contents/Resources/Data/Managed</GameManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(SteamGameRoot)/BepInEx/core</BepInExCorePath>
  </PropertyGroup>

  <!--
    Private=false on every framework reference: the framework, BepInEx and Unity are already
    loaded in the game. Never ship your own copy of them - the loader ignores such a copy with one
    MODS warning and never loads it, and the pack step below leaves them out anyway. Your own
    helper libraries and NuGet packages ship next to MyMod.dll.
  -->
  <ItemGroup>
    <Reference Include="CwyLs.ModLoader">
      <HintPath>$(CwyRepoRoot)src/CwyLs.ModLoader/bin/$(CwyConfiguration)/netstandard2.1/CwyLs.ModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CwyLs.ModLoader.Core">
      <HintPath>$(CwyRepoRoot)src/CwyLs.ModLoader.Core/bin/$(CwyConfiguration)/netstandard2.1/CwyLs.ModLoader.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedPath)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" />
  </ItemGroup>

  <!--
    bin/<Configuration>/netstandard2.1/pack/<ModId>/: the whole mod folder. The DLL, its symbols and
    the manifest, plus every private dependency (@(ReferenceCopyLocalPaths)) except the ones the
    game, BepInEx or CWY:LS Mod Loader already provide: a DLL of that name in the game's Managed folder or
    BepInEx's core folder, or one of the framework/game/Unity/BepInEx/Harmony/MonoMod/Cecil families.
    That is the loader's own shared-name rule (ModAssemblyRules), applied at build time.
  -->
  <Target Name="AssemblePack" AfterTargets="Build">
    <PropertyGroup>
      <PackDir>$(OutDir)pack/$(ModId)/</PackDir>
      <_CwySharedFamilies>(?i)^(CwyLs\.ModLoader|Assembly-CSharp|UnityEngine|Unity|BepInEx|0Harmony|HarmonyX|MonoMod|Mono\.Cecil|mscorlib|netstandard)([.-].*)?$</_CwySharedFamilies>
    </PropertyGroup>
    <ItemGroup>
      <_CwySharedDll Include="$(GameManagedPath)/*.dll;$(BepInExCorePath)/*.dll" />
      <_CwyCopyLocal Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
    <PropertyGroup>
      <_CwySharedNames>@(_CwySharedDll->'%(Filename)')</_CwySharedNames>
      <_CwySharedNames>;$(_CwySharedNames.ToLowerInvariant());</_CwySharedNames>
    </PropertyGroup>
    <ItemGroup>
      <_CwyPrivateDependency Include="@(_CwyCopyLocal)"
        Condition="!$(_CwySharedNames.Contains(';$([System.String]::Copy('%(Filename)').ToLowerInvariant());')) and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_CwySharedFamilies)'))" />
    </ItemGroup>
    <MakeDir Directories="$(PackDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;manifest.json" DestinationFolder="$(PackDir)" />
    <Copy SourceFiles="@(_CwyPrivateDependency)"
          DestinationFiles="@(_CwyPrivateDependency->'$(PackDir)%(DestinationSubDirectory)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="$(ModId) -> $(PackDir) (private dependencies: @(_CwyPrivateDependency->'%(Filename)%(Extension)', ', '))" />
  </Target>

</Project>
